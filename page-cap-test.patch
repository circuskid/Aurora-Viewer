+// wgpu-hal sizes a descriptor pool for at least 64 sets of a layout; the
+// texture layout's pool (pages + sampler + buffer per set) must fit the
+// driver's update-after-bind total.
+#[cfg(not(target_os = "macos"))]
+fn pool_page_limit(adapter: &wgpu::Adapter) -> u32 {
+    use ash::vk;
+    // SAFETY: the hal adapter is only borrowed for this property query.
+    let Some(hal) = (unsafe { adapter.as_hal::<wgpu::hal::api::Vulkan>() }) else {
+        return u32::MAX;
+    };
+    let instance = hal.shared_instance().raw_instance();
+    let mut di = vk::PhysicalDeviceDescriptorIndexingProperties::default();
+    let mut props = vk::PhysicalDeviceProperties2::default().push_next(&mut di);
+    unsafe { instance.get_physical_device_properties2(hal.raw_physical_device(), &mut props) };
+    (di.max_update_after_bind_descriptors_in_all_pools / 64).saturating_sub(2)
+}
+#[cfg(target_os = "macos")]
+fn pool_page_limit(_adapter: &wgpu::Adapter) -> u32 {
+    u32::MAX
+}
